# hello_imgui-config.cmake (generated from hello_imgui-config.cmake.in at build time)
include(CMakeFindDependencyMacro)

# Dependencies (which ones depends on the build options)
if(@HIM_CFG_IMGUI_PACKAGE@)
    find_dependency(imgui CONFIG)        # HELLOIMGUI_USE_IMGUI_CMAKE_PACKAGE (e.g. vcpkg)
endif()
if(@HIM_CFG_GLAD_PACKAGE@)
    find_dependency(glad CONFIG)
endif()
if(@HIM_CFG_JSON_PACKAGE@)
    find_dependency(nlohmann_json CONFIG)
endif()
find_dependency(Threads)                 # plutosvg
if(@HIM_CFG_FREETYPE@)
    find_dependency(Freetype)
endif()
if(@HIM_CFG_GLFW3@)
    find_dependency(glfw3)               # system glfw, or the one built and installed with hello_imgui
endif()
if(@HIM_CFG_SDL2@)
    find_dependency(SDL2)
endif()
if(@HIM_CFG_OPENGL@)
    find_dependency(OpenGL)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/hello_imgui_cmake/hello_imgui_add_app.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/hello_imgui-targets.cmake)
